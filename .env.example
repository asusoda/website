# API Configuration (example only)
# Copy this file to .env and adjust as needed
VITE_API_URL=https://api.thesoda.io

# Clerk Authentication (required for Shop features like sign-in, cart, and checkout)
# Use a development/test publishable key from your Clerk dashboard:
#   https://dashboard.clerk.com -> Your application -> API Keys -> "Publishable key"
# If this value is left empty, Clerk authentication will be disabled and Shop-related
# features in the SoDA site will not work in development.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: Organization prefix for the Shop API.
# Override this if you need to point the Shop at a non-default organization.
VITE_ORG_PREFIX=
